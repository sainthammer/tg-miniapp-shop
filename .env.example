BOT_TOKEN=your_bot_token_here
APP_URL=https://your-public-domain.example.com

# Список chat ID администраторов через запятую (один или несколько).
# Пример: ADMIN_CHAT_IDS=123456789,987654321
ADMIN_CHAT_IDS=123456789

# Устаревшая переменная — поддерживается для обратной совместимости.
# Если указан ADMIN_CHAT_IDS — ADMIN_CHAT_ID можно не задавать.
# ADMIN_CHAT_ID=123456789

MANAGER_LINK=https://t.me/your_manager_username
PORT=8080
